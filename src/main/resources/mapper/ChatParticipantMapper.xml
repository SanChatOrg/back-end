<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sanchat.api.mapper.ChatParticipantMapper">

    <insert id="save" parameterType="ChatMessageDTO" useGeneratedKeys="true" keyProperty="chatPartNo">
        insert into chat_participant (chat_part_no, user_no, chat_room_no)
        values (#{chatPartNo}, #{userNo}, #{chatRoomNo})
    </insert>

</mapper>